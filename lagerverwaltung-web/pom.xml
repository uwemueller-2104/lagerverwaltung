<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.web192.lagersoftware</groupId>
    <artifactId>lagersoftware</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>lagerverwaltung-web</artifactId>
  <packaging>jar</packaging>
  <name>lagerverwaltung-web</name>
  <description>Praesentationsschicht: Verwaltungs-GUI und mobile Ansicht, lauffaehige Spring-Boot-Anwendung</description>

  <dependencies>
    <dependency>
      <groupId>de.web192.lagersoftware</groupId>
      <artifactId>lagerverwaltung-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>de.web192.lagersoftware</groupId>
      <artifactId>benutzerverwaltung</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <!-- Login (lokal, Benutzername/Passwort) + rollenbasierte Zugriffssteuerung.
         Microsoft-Login ist als eigener Backlog-Punkt geplant und kommt spaeter
         als zusaetzlicher OAuth2/OIDC-Client dazu, ohne dass hier etwas
         umgebaut werden muss. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.thymeleaf.extras</groupId>
      <artifactId>thymeleaf-extras-springsecurity6</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- DB-Migrationen statt Hibernate ddl-auto: Version wird von
         spring-boot-starter-parent verwaltet, passend zu H2 3.3.x. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
